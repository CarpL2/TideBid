# Copy this file to .env and replace every "change-me" value before starting TideBid.
# The values below are local-development placeholders, not production defaults.

# MySQL
TIDEBID_MYSQL_HOST=127.0.0.1
TIDEBID_MYSQL_PORT=13306
TIDEBID_MYSQL_ROOT_PASSWORD=change-me-local-root-password
TIDEBID_ACCOUNT_DB_PASSWORD=change-me-account-db-password
TIDEBID_AUCTION_DB_PASSWORD=change-me-auction-db-password
TIDEBID_TRADE_DB_PASSWORD=change-me-trade-db-password
TIDEBID_AI_DB_PASSWORD=change-me-ai-db-password

# Redis
TIDEBID_REDIS_HOST=127.0.0.1
TIDEBID_REDIS_PORT=6379
TIDEBID_REDIS_PASSWORD=change-me-local-redis-password

# Nacos
TIDEBID_NACOS_SERVER_ADDR=127.0.0.1:8848
TIDEBID_NACOS_NAMESPACE=tidebid-dev
TIDEBID_NACOS_GROUP=TIDEBID_GROUP
TIDEBID_NACOS_DISCOVERY_IP=127.0.0.1
TIDEBID_NACOS_USERNAME=nacos
TIDEBID_NACOS_PASSWORD=change-me-local-nacos-password
TIDEBID_NACOS_DB_PASSWORD=change-me-nacos-db-password
# Base64 of at least 32 random bytes. Do not reuse the example value locally.
TIDEBID_NACOS_AUTH_TOKEN=change-me-base64-secret-at-least-32-bytes
TIDEBID_NACOS_AUTH_IDENTITY_KEY=change-me-nacos-identity-key
TIDEBID_NACOS_AUTH_IDENTITY_VALUE=change-me-nacos-identity-value

# RocketMQ
# Host applications connect to the Proxy gRPC port using host:port without http://.
TIDEBID_ROCKETMQ_ENDPOINTS=127.0.0.1:8081

# JWT development keys (generated locally; never commit the key files)
TIDEBID_JWT_PRIVATE_KEY_PATH=.runtime/keys/jwt-private.pem
TIDEBID_JWT_PUBLIC_KEY_PATH=.runtime/keys/jwt-public.pem

# Internal service authentication. Generate a high-entropy value of at least 32 bytes.
TIDEBID_INTERNAL_SERVICE_TOKEN=change-me-internal-service-token-at-least-32-bytes
TIDEBID_ACCOUNT_BASE_URL=http://127.0.0.1:9101

# Optional local development administrator. Set a strong password before enabling.
TIDEBID_DEV_ADMIN_ENABLED=false
TIDEBID_DEV_ADMIN_USERNAME=tidebid_admin
TIDEBID_DEV_ADMIN_PASSWORD=
TIDEBID_DEV_ADMIN_NICKNAME=TideBid Administrator

# Optional Alibaba Cloud integrations. OSS remains disabled until all required values are set.
TIDEBID_OSS_ENABLED=false
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
TIDEBID_OSS_ENDPOINT=
TIDEBID_OSS_REGION=cn-beijing
TIDEBID_OSS_BUCKET=
DASHSCOPE_API_KEY=
